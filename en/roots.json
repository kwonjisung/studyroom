us", "위에 더 → 흑자"], ["survive", "위로 살아 넘다 → 살아남다"], ["surname", "이름 위에 → 성"]], "s": [["sur", "위에(super)"], ["charge", "짐·요금"]], "t": "sur = 위에, 넘어"}, "surgically": {"c": "손으로 하는 일(chirurgia) → 외과 수술로", "f": [["surgery", "수술"], ["surgeon", "외과의사"], ["energy", "안에서 하는 일"], ["ergonomic", "인체공학적"]], "s": [["sur", "손(kheir)"], ["g", "일(ergon)"]], "t": "erg = 일"}, "survey": {"c": "위에서 내려다보다 → 조사하다, 설문 조사", "f": [["view", "보기"], ["video", "나는 본다"], ["evident", "밖으로 보이는 → 명백한"], ["supervise", "위에서 보다 → 감독"]], "s": [["sur", "위에서"], ["vey", "보다(videre)"]], "t": "vid/vis/vey = 보다"}, "survive": {"c": "(위험·남들을) 넘어서 살다 → 살아남다, 남아 있다", "f": [["survival", "살아남음 → 생존"], ["revive", "다시 살다 → 되살리다"], ["vivid", "살아 있는 듯한 → 생생한"], ["surpass", "넘어 지나가다 → 능가하다"]], "s": [["sur", "넘어, 위로(super)"], ["vive", "살다(vivere)"]], "t": "viv = 살다, sur- = 위·넘어 (surface, surpass)"}, "swap": {"c": "중세 영어 '손바닥을 치다' → 손뼉 쳐서 거래 성사 → 맞바꾸다", "f": [["swap A for B", "A를 B로 바꾸다"], ["swap meet", "물물교환 장터"]]}, "tadpole": {"c": "두꺼비 + 머리 → 머리만 있는 것처럼 보이는 새끼 두꺼비 → 올챙이", "f": [["toad", "두꺼비"], ["poll", "머리 → 머릿수 세기 → 여론조사·투표"]], "s": [["tad", "두꺼비(tadde)"], ["pole", "머리(poll)"]], "t": "몸통 없이 머리만 동글동글한 모습을 그대로 이름 붙인 중세 영어 단어"}, "tariff": {"c": "아랍어 ta'rīf '알림' → 세금 목록을 알린 것 → 관세표 → 관세", "t": "지중해 무역 시절 아랍어에서 들어온 말"}, "template": {"c": "원래 templet: 목수가 모양 본을 뜨는 얇은 판 → 견본 틀", "t": "똑같은 모양을 찍어내는 '본'"}, "territory": {"c": "도시를 둘러싼 땅 → 다스리는 땅 → 영토·(미국) 준주", "f": [["terrain", "땅 → 지형"], ["terrace", "흙을 쌓아 올린 단 → 테라스"], ["Mediterranean", "땅(terra) 가운데(medi) 바다 → 지중해"], ["extraterrestrial", "땅 밖의 → 외계의·외계인"]], "s": [["terri", "땅(terra)"], ["tory", "~하는 곳(-orium)"]], "t": "terra = 땅. 일부에서는 terrere(겁주다)에서 왔다는 설도 있음 — 어원 완전히 확실하진 않음"}, "thermal": {"c": "열의 → 열을 감지하는·열을 내는", "f": [["thermometer", "열 + 재는 것 → 온도계"], ["thermos", "열을 지키는 병 → 보온병"], ["thermostat", "열 + 멈춰 세움 → 온도 조절기"]], "s": [["therm", "열(그리스어 thermē)"], ["al", "~의"]], "t": "therm = 열 (meter = 재다)"}, "thriving": {"c": "고대 노르드어 thrifask '붙잡다, 번창하다'에서 → 잘 자라다 → 번성하는", 