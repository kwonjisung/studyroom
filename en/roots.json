{"accuse": {"c": "~에게 잘못의 이유를 돌리다 → 비난하다, 고소하다", "f": [["cause", "원인"], ["excuse", "이유에서 빼내다 → 변명·용서"], ["because", "by cause"]], "s": [["ac(ad)", "~에게"], ["cuse", "이유·소송(causa)"]], "t": "cus/caus = 이유"}, "adapt": {"c": "~에 맞추다 → 적응하다", "f": [["apt", "적절한"], ["aptitude", "적성"], ["adaptation", "적응·각색"]], "s": [["ad", "~에"], ["apt", "맞는"]], "t": "adopt(입양·채택하다)와 헷갈림 주의"}, "adopt": {"c": "~쪽으로 골라 가지다 → 내 것으로 받아들이다 → 채택하다·입양하다", "f": [["opt", "고르다 → 선택하다"], ["option", "고름 → 선택권"], ["adoption", "골라 받아들임 → 입양·채택"]], "s": [["ad", "~쪽으로, ~에게"], ["opt", "고르다, 바라다(optare)"]], "t": "opt = 고르다. adapt(적응하다)는 apt(맞는)에서 온 다른 단어"}, "antiviral": {"c": "바이러스에 맞서는 → 항바이러스성의", "f": [["antibiotic", "항생제"], ["antibody", "항체"], ["antisocial", "반사회적인"], ["virus", "바이러스"]], "s": [["anti", "맞서는"], ["vir", "바이러스(라틴어 '독')"]], "t": "anti = 맞서는, 반대"}, "approval": {"c": "시험해 보고 '좋다'고 해 줌 → 승인", "f": [["prove", "증명하다"], ["probe", "조사하다"], ["improve", "더 좋게 하다"], ["disapprove", "반대하다"]], "s": [["ap(ad)", "~에"], ["prov", "시험해 좋다고 봄"]], "t": "prob/prov = 시험하다, 좋다고 판단"}, "arsenic": {"c": "페르시아어 zarnīk '황금빛' → 그리스어 arsenikon(노란 광물) → 비소"}, "atmosphere": {"c": "지구를 감싼 증기의 구 → 대기, 분위기", "f": [["hemisphere", "반구"], ["sphere", "구"], ["biosphere", "생물권"]], "s": [["atmo", "증기"], ["sphere", "구"]], "t": "sphere = 둥근 공"}, "attach": {"c": "말뚝에 묶어 매다 → 붙이다, 부착하다", "f": [["detach", "말뚝에서 떼다 → 떼어 내다"], ["attachment", "붙임 → 첨부 파일·애착"], ["attack", "(이탈리아어 attaccare 붙다) 달라붙다 → 공격하다"], ["stake", "말뚝"]], "s": [["at(ad)", "~에"], ["tach", "말뚝(estache)"]], "t": "tach = 말뚝(stake). de-(떼어)를 붙이면 반대말 detach"}, "attract": {"c": "~쪽으로 끌어당기다", "f": [["tractor", "끄는 기계"], ["extract", "밖으로 끌어내다 → 추출"], ["distract", "딴 데로 끌다 → 산만하게"], ["contract", "함께 끌어 맺다 → 계약"]], "s": [["at(ad)", "~쪽으로"], ["tract", "끌다"]], "t": "tract = 끌다"}, "banner": {"c": "후기 라틴어 bandum(군기, 게르만어에서 옴) → 고대 프랑스어 baniere → 군대 깃발 → 현수막·배너", "t": "인터넷 '배너 광고'도 같은 말 — 가로로 길게 내건 깃발"}, "biodiversity": {"c": "생명이 여러 방향으로 갈라져 돎 → 생물 다양성", "f": [["biology", "생물학"], ["div