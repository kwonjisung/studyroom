[["inspire", "숨을 불어넣다 → 영감을 주다"], ["respiration", "거듭 숨 쉬기 → 호흡"], ["spirit", "숨 → 정신·영혼"], ["conspire", "함께 숨 쉬다 → 공모하다"]], "s": [["ex", "밖으로"], ["spire", "숨 쉬다(spirare)"]], "t": "spir = 숨 쉬다 (ex+spire 에서 s가 빠져 expire)"}, "explosion": {"c": "원래 '박수 쳐서 배우를 무대 밖으로 쫓아내다' → 쾅 터져 나감", "f": [["explode", "폭발하다"], ["applause", "~에 박수"], ["plausible", "박수 받을 만한 → 그럴듯한"]], "s": [["ex", "밖으로"], ["plos", "손뼉 치다(plaudere)"]]}, "exposure": {"c": "밖에 내놓음 → 노출", "f": [["expose", "드러내다"], ["position", "놓인 자리"], ["deposit", "아래에 놓다 → 예금"], ["propose", "앞에 놓다 → 제안"]], "s": [["ex", "밖에"], ["pos", "놓다"]], "t": "pos/pon = 놓다"}, "fatigue": {"c": "라틴어 fatigare '지치게 하다' → 피로", "f": [["indefatigable", "지칠 줄 모르는"]], "t": "발음 주의: 퍼-티-ㄱ (fuh-TEEG)"}, "feathered": {"c": "깃털 + -ed(~이 달린) → 깃털이 달린", "f": [["winged", "날개 + -ed → 날개 달린"], ["bearded", "수염 + -ed → 수염 난"], ["helicopter", "나선(helix) + 날개(pteron) → 헬리콥터"]], "s": [["feather", "깃털"], ["ed", "~을 가진"]], "t": "명사 + -ed = ~을 가진. feather 는 '날다'라는 옛 뿌리(PIE *pet-)에서 왔고, 그리스어 pteron(날개)과 같은 뿌리"}, "federally": {"c": "맹약으로 묶인 주(州)들 → 연방 → 연방 차원에서", "f": [["federal", "연방의"], ["federation", "연맹"], ["confederate", "함께 맹약한 → 동맹"]], "s": [["feder", "맹약(foedus)"], ["al", "~의"], ["ly", "~하게"]], "t": "형용사 + ly = 부사"}, "forage": {"c": "프랑크어 fodr '사료' → 꼴을 찾아다니다 → 먹이를 찾아다니다", "f": [["fodder", "가축 사료"], ["food", "음식(먼 친척)"]]}, "forecast": {"c": "앞으로 던져 내다보다 → 예측하다", "f": [["foresee", "미리 보다"], ["forehead", "앞머리 → 이마"], ["foreword", "앞말 → 서문"], ["broadcast", "넓게 던지다 → 방송"]], "s": [["fore", "앞·미리"], ["cast", "던지다"]], "t": "fore = 앞"}, "fossil": {"c": "땅에서 파낸 것 → (처음엔 파낸 광물·돌 전부) → 화석", "f": [["fossil fuel", "땅에서 파낸 연료 → 화석 연료"], ["fossilize", "화석으로 만들다 → 화석화하다, 굳어 버리다"]], "s": [["foss", "파다(fodere)"], ["il", "~할 수 있는·~한 것"]], "t": "fodere = 파다. '화석 같은 사람'처럼 낡은 것을 비유할 때도 씀"}, "genetics": {"c": "태어남·기원에 관한 것 → 대대로 물려받는 성질 → 유전(학), 유전적 특징", "f": [["gene", "낳는 것 → 유전자"], ["genesis", "태어남 → 기원·창세기"], ["generation", "낳아진 무리 → 세대"], ["generate", "낳다 → 만들어 내다"]], "s": [["gene", "낳다, 태어남(genesis)"], ["-tic", "~에 관한"], ["-s", "학문"]], "t": "gen = 낳다, 태어나다 (그리스어 genesis와 라틴어 generare는 같은 뿌리의 사촌)"}, "grab": {"c": "확 움켜쥐다 (중세 네덜란드어 grabben)", "f": [["grip", "꽉 쥠"], ["grasp", "움켜잡다·이해하다"], ["grab-and-go", "집어 들고 가는"]], "t": "gr- 로 시작하는 '꽉 쥐다' 무리"}, "habitat": {"c": "라틴어 '그것은 (여기에) 산다' → 동식물이 사는 곳 → 서식지 (옛 박물학 책에서 서식지를 적던 말)", "f": [["inhabit", "안에(in) 살다 → 거주하다"], ["habitation", "사는 일 → 거주(지)"], ["habit", "(habere 지니다) 몸에 지닌 것 → 습관"], ["exhibit", "밖으로(ex) 내어 지니다 → 전시하다"]], "s": [["habit", "살다, 머물다(habitare)"], ["at", "(그것이) ~한다"]], "t": "hab = 지니다(habere) → 자주 머물다(habitare). habit(습관)과 같은 뿌리"}, "harsh": {"c": "중세 영어 harsk(스칸디나비아어에서 온 듯, 덴마크어 harsk = 상한 맛) → 거칠고 껄끄러운 → 가혹한·혹독한 (어원 일부 불확실)", "t": "harsh weather = 혹독한 날씨, harsh words = 모진 말"}, "homeland": {"c": "내 집이 있는 땅 → 고향, 본거지", "f": [["hometown", "고향 마을"], ["homesick", "향수병"], ["mainland", "본토"]], "s": [["home", "집"], ["land", "땅"]]}, "hospitalization": {"c": "손님 맞는 곳(hospital)에 받아들여짐 → 입원", "f": [["hospitality", "환대"], ["host", "주인"], ["hostel", "숙소"], ["hotel", "호텔"]], "s": [["hospit", "손님(hospes)"]], "t": "-ation 이 붙으면 명사"}, "hypothesis": {"c": "생각의 밑에 깔아 놓은 것 → 가설", "f": [["thesis", "논제·논문"], ["synthesis", "함께 놓기 → 합성"], ["hypothermia", "정상 아래 체온 → 저체온증"]], "s": [["hypo", "아래"], ["thesis", "놓은 것"]], "t": "hypo = 아래 ↔ hyper = 위·지나침"}, "incubate": {"c": "위에 엎드려 눕다 → 알을 품다", "f": [["incubator", "부화기·인큐베이터"], ["cubicle", "눕는 칸 → 칸막이 자리"]], "s": [["in", "위에"], ["cub", "눕다(cubare)"]], "t": "cub = 눕다"}, "independent": {"c": "아래에 매달리지(depend) 않는 → 독립적인", "f": [["depend", "아래에 매달리다 → 의존"], ["pendant", "매달린 장식"], ["pendulum", "진자"], ["suspend", "아래로 매달다 → 중단"]], "s": [["in", "아님"], ["de", "아래로"], ["pend", "매달리다"]], "t": "pend = 매달리다"}, "infection": {"c": "안에 집어넣다 → (병균을) 물들이다 → 감염", "f": [["affect", "~에 작용하다 → 영향을 주다"], ["effect", "밖으로 만들어 낸 것 → 결과·효과"], ["perfect", "완전히 만든 → 완벽한"], ["factory", "만드는 곳 → 공장"]], "s": [["in", "안에"], ["fect", "만들다, 넣다(facere)"], ["ion", "~하는 것"]], "t": "fect·fac = 만들다, 하다"}, "inspire": {"c": "안으로 숨을 불어넣다 → 영감을 주다", "f": [["spirit", "숨 → 영혼·정신"], ["expire", "숨을 내쉬다 → 만료되다"], ["respire", "호흡하다"], ["aspire", "~를 향해 숨 쉬다 → 열망하다"]], "s": [["in", "안으로"], ["spire", "숨 쉬다"]], "t": "spir = 숨"}, "internal": {"c": "안쪽의 → 내부의, 체내의", "f": [["interior", "내부"], ["intern", "안에서 일하는 사람 → 인턴"], ["international", "나라 사이의 (inter-)"], ["interval", "사이 간격 (inter-)"]], "s": [["intern", "안쪽의(internus)"]], "t": "in·intern = 안 / inter- = 사이 (international, internet, interview). 모양이 닮아 함께 알아두면 좋아요"}, "interpretation": {"c": "둘 사이에서 풀어 주는 사람(interpres) → 뜻을 풀어 설명함 → 해석", "f": [["interpreter", "사이에서 풀어 주는 사람 → 통역사"], ["international", "나라 사이의 → 국제적인"], ["interview", "서로 사이에서 보다 → 면접·인터뷰"], ["interrupt", "사이를 깨다 → 방해하다"]], "s": [["inter", "사이"], ["pret", "어원 불확실(값 pretium 설)"], ["ation", "~하는 것"]], "t": "inter- = 사이. 뒷부분 -pret 는 어원이 확실하지 않음(값·거래를 뜻하는 pretium 과 잇는 설)"}, "intriguing": {"c": "마음을 얽어 붙잡는 → 아주 흥미로운", "f": [["intrigue", "음모·흥미를 끌다"], ["intricate", "복잡하게 얽힌"], ["extricate", "얽힘에서 빼내다"]], "s": [["in", "안"], ["trig", "얽힘(tricae)"]]}, "isolated": {"c": "섬처럼 만들다 → 따로 떼어 놓다 → 고립된", "f": [["isle", "섬"], ["peninsula", "거의 + 섬 → 반도"], ["insulate", "섬으로 만들다 → 절연·단열하다"]], "s": [["isol", "섬(라틴어 insula)"], ["ate", "~하게 하다"], ["ed", "~된"]], "t": "insula·isol = 섬 (insulin도 '섬' 모양 세포에서 나와 붙은 이름)"}, "jail": {"c": "라틴어 cavea(우리) → 작은 우리 caveola → 고대 프랑스어 gaiole → 감옥 → (동사) 감옥에 가두다", "f": [["cage", "같은 cavea → 새장·우리"], ["cave", "cavus(속이 빈) → 동굴"], ["gaol", "jail의 영국식 옛 철자(발음 같음)"]], "t": "jail과 cage는 같은 뿌리(cavea = 속이 빈 곳, 우리)"}, "label": {"c": "고대 프랑스어 '리본, 천 조각' → 붙여 둔 천 조각 → 표시하다", "f": [["relabel", "다시 표시하다"], ["record label", "음반사"]]}, "lawmaker": {"c": "법을 만드는 사람 → 입법자·국회의원", "f": [["lawyer", "법을 다루는 사람 → 변호사"], ["outlaw", "법 밖에 놓인 사람 → 무법자"], ["bylaw", "마을(by)의 법 → 내규·조례"], ["lay", "놓다 (law와 같은 뿌리)"]], "s": [["law", "법(놓인 것)"], ["make", "만들다"], ["er", "~하는 사람"]], "t": "law는 고대 노르드어 lagu '놓인 것(정해 둔 것)'에서 — lay(놓다)와 같은 뿌리"}, "legally": {"c": "법에 따라 → 법적